{
  "name": "stayx-pos",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20.0.0", "pnpm": ">=9.0.0" },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @stayx/api run dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter @stayx/database run db:generate",
    "db:migrate": "pnpm --filter @stayx/database run db:migrate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "pnpm": { "overrides": { "@types/node": "^22.0.0" } }
}