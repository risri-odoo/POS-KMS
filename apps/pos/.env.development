# Committed on purpose: no secrets. Used by `vite` (dev server) only.
# Property shown when the URL has no ?propertyId= (the demo property used by pnpm seed:demo).
VITE_DEFAULT_PROPERTY_ID=a0000001-0000-4000-a000-000000000001

# Staff login (INTEGRATION_DESIGN.md §8.6). Leave empty for login off, with the API's
# POS_AUTH_ENABLED=false. To sign in against the local Keycloak (Step G), put these in
# apps/pos/.env.development.local (gitignored), not here:
#   VITE_OIDC_AUTHORITY=http://localhost:8080/realms/haip
#   VITE_OIDC_CLIENT_ID=stayx-pos-web
VITE_OIDC_AUTHORITY=
