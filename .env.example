# StayX POS — copy to .env (gitignored) and fill in. Real environment variables win over this file.

# API
PORT=4000
DATABASE_URL=postgres://stayx:stayx@localhost:5433/stayx_pos
CORS_ORIGINS=http://localhost:5181,http://127.0.0.1:5181,http://localhost:5180,http://127.0.0.1:5180
REDIS_URL=redis://localhost:6380

# HAIP bridge. Leave HAIP_API_KEY empty to disable posting (orders are still recorded in the outbox).
HAIP_API_URL=http://localhost:3000/api/v1
HAIP_API_KEY=
# The HAIP property the key is bound to. Orders from any other property are not posted.
HAIP_PROPERTY_ID=00000000-0000-0000-0000-000000000000
# Time zone used for the folio service date.
HAIP_TIMEZONE=America/New_York

# Guest stay lookup, used to bind orders to the guest's stay.
# Unset: not configured, so staff orders are saved as "unverified".
# fake: made-up demo stays for local development only. The API refuses to start with it when NODE_ENV=production.
# haip: HAIP staff REST with a service principal (Keycloak client credentials). Needs the four settings below.
HAIP_STAY_LOOKUP=
# HAIP staff REST base for the lookup (defaults to HAIP_API_URL). Must be an auth-on HAIP.
HAIP_STAFF_API_URL=
# Service principal. Keep the secret out of git; set it in the real .env or the environment.
HAIP_SP_TOKEN_URL=
HAIP_SP_CLIENT_ID=
HAIP_SP_CLIENT_SECRET=

# Staff login (OIDC; Keycloak in the HAIP realm). On by default; the API refuses to start in production with it off.
# Local development without sign-in: set POS_AUTH_ENABLED=false (the screens don't send tokens yet).
POS_AUTH_ENABLED=true
# Token issuer, e.g. http://localhost:8080/realms/haip. Required while auth is on.
POS_OIDC_ISSUER=
# Optional overrides (defaults shown in comments):
# POS_OIDC_JWKS_URI=        (<issuer>/protocol/openid-connect/certs)
# POS_OIDC_AUDIENCE=        (stayx-pos-api)
# POS_OIDC_ALLOWED_AZP=     (stayx-pos-web,stayx-kms-web)
# POS_OIDC_ROLES_CLAIM=     (resource_access.<audience>.roles)
# The screens sign in with VITE_OIDC_AUTHORITY (same issuer) and VITE_OIDC_CLIENT_ID
# (stayx-pos-web / stayx-kms-web), set in each app's .env.development.local. Unset: login off.
